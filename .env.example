# Copy to .env for a new installation. KEEP your existing .env when upgrading.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
MASTER_ENCRYPTION_KEY=
DATABASE_URL=

# Identity is cosmetic. Keep the same Discord application ID to retain old data.
BOT_NAME=Caretaker
# BOT_OWNER_ID=your_discord_user_id

# Aiven: paste its Service URI above and download its project CA to this path.
# Keep certificate verification enabled for hosted databases.
DATABASE_SSL=verify-full
DATABASE_CA_FILE=certs/aiven-ca.pem
DATABASE_POOL_SIZE=5

# HTTP is optional and disabled by default. Its key is a server-side admin secret.
HTTP_ENABLED=false
HTTP_HOST=127.0.0.1
PORT=8000
# API_SECRET_KEY=generate_a_random_secret_of_at_least_32_characters

# Set this to deploy commands to one test server. Omit for global deployment.
# COMMAND_GUILD_ID=your_test_server_id
LOG_LEVEL=info
